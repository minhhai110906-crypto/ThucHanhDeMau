@model List<PhamHaiMinh_241230797.Models.Sach>
@for (int i =0; i < Model.Count; i += 4)
{
    <div class= "grid">
        @foreach (var item in Model.Skip(i).Take(4))
        {
            <div class="book-card">
                <a href="#"><img src="images/@item.Anh" alt="" /></a>
                <h2>@item.TenSach</h2>
                <div class="book-foot"><span class="price">@item.Gia</span><button class="btn-buy">Them vao gio</button></div>
            </div>
        }
    </div>
}
